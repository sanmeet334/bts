# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CLIENT_ORIGIN="http://localhost:3000"

# Database Configuration (SQLite by default; switchable in repository layer)
DATABASE_PATH="./data/traffix.db"

# Authentication & Security (Replace with strong random secrets in production)
JWT_SECRET="replace-with-secure-random-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-secure-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# External Provider Adapters (Optional — system falls back to clearly labelled deterministic simulation)
ROUTING_PROVIDER="SIMULATED_GRAPH"
LIVE_ROUTING_API_URL=""
LIVE_ROUTING_API_KEY=""
WEATHER_PROVIDER="SIMULATED_WEATHER"
LIVE_WEATHER_API_KEY=""

# Optional Python Prediction Microservice URL (TypeScript baseline runs in-process when empty)
PREDICTION_SERVICE_URL=""

# Google Maps Platform API Keys (Maps JavaScript API, Places API (New), Routes API)
# Set VITE_GOOGLE_MAPS_API_KEY for the browser Maps JS / Places / Routes SDKs.
VITE_GOOGLE_MAPS_API_KEY=""
# Optional server-side Google Maps Platform key for backend Places/Geocoding/Routes requests.
GOOGLE_MAPS_API_KEY=""

# Frontend Client Configuration
VITE_API_BASE_URL="/api"

